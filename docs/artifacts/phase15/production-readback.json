  "constraints": [
    {
      "name": "estimates_sage_document_kind_check",
      "valid": true,
      "definition": "CHECK (((sage_document_kind IS NULL) OR (sage_document_kind = ANY (ARRAY['sales_estimate'::text, 'sales_quote'::text]))))"
    },
    {
      "name": "estimates_document_kind_check",
      "valid": true,
      "definition": "CHECK ((document_kind = ANY (ARRAY['estimate'::text, 'change_order'::text])))"
    },
    {
      "name": "estimates_baseline_estimate_id_fkey",
      "valid": true,
      "definition": "FOREIGN KEY (baseline_estimate_id) REFERENCES estimates(id)"
    },
    {
      "name": "estimates_currency_code_check",
      "valid": true,
      "definition": "CHECK ((currency_code = ANY (ARRAY['CAD'::text, 'USD'::text])))"
    },
    {
      "name": "estimates_change_order_baseline",
      "valid": true,
      "definition": "CHECK ((((document_kind = 'estimate'::text) AND (baseline_estimate_id IS NULL)) OR ((document_kind = 'change_order'::text) AND (baseline_estimate_id IS NOT NULL) AND (project_id IS NOT NULL))))"
    },
    {
      "name": "estimates_private_draft_custody",
      "valid": true,
      "definition": "CHECK (((NOT distribution_hold) OR ((status = 'draft'::text) AND (currency_code IS NOT NULL) AND (sent_at IS NULL) AND (viewed_at IS NULL) AND (approved_at IS NULL) AND (qb_id IS NULL) AND (sage_id IS NULL))))"
    },
