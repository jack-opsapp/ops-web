          {
            "headline": "Take the before shot",
            "body": "Stand back.\n\nPick one clear angle that shows the full starting point.",
            "alt_text": "Take the before shot"
          },
          {
            "headline": "Show the hidden work",
            "body": "Capture one useful detail during the job.\n\nThe part that gets covered up is often the part worth showing.",
            "alt_text": "Show the hidden work"
          },
          {
            "headline": "Return to the same angle",
            "body": "Take the finished shot from where you started.\n\nMake the change easy to see.",
